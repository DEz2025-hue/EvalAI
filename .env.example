# EvalAI environment — copy to .env.local (never commit real values)
# Public (client) — only intentionally public values may use NEXT_PUBLIC_ prefix
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only secrets — never use NEXT_PUBLIC_ / EXPO_PUBLIC_ for these
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI provider — server-only
AI_PROVIDER_API_KEY=your-meta-api-key
AI_PROVIDER_BASE_URL=https://api.meta.ai
# Model ids must be the exact versioned ids from GET /v1/models (unversioned ids like "muse-spark" return 404).
# Use STANDARD models only: ids ending in "-contributor" let Meta train on your content and are refused by the app.
META_SPARK_MODEL=muse-spark-1.3
META_WONDER_MODEL=muse-wonder-1.0
META_VOICE_MODEL=muse-voice-transcribe-1.0
META_SAM_MODEL=sam-3.1
# Optional per-operation tuning (defaults: clarify=low, checklist=medium, analyze=high, image=low, report=medium):
# AI_EFFORT_ANALYZE=high          # minimal | low | medium | high | xhigh | max
# AI_MODEL_ANALYZE=muse-wonder-1.0  # trial Wonder (preview, ~3-5x cost) for analysis only
# AI_MAX_TOKENS_ANALYZE=16000     # reasoning tokens count against this limit
# AI_DAILY_COST_CAP_USD=5         # per-workspace daily estimated spend cap (needs migration 0013)
# AI_VOICE_MODE=ENDPOINTING       # PUSH_TO_TALK | ENDPOINTING | DIARIZATION

# Demo mode (local only): set to 1 to allow unauthenticated access when
# NODE_ENV=production. Leave unset in real deployments.
# DEMO_MODE=

# Mobile (apps/mobile) — public values only
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_APP_URL=https://your-web-app.vercel.app
