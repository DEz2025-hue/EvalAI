# EvalAI environment — copy to .env.local (never commit real values)
# Public (client) — only intentionally public values may use NEXT_PUBLIC_ prefix
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only secrets — never use NEXT_PUBLIC_ / EXPO_PUBLIC_ for these
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI provider — server-only
AI_PROVIDER_API_KEY=your-meta-api-key
AI_PROVIDER_BASE_URL=https://api.meta.ai
META_WONDER_MODEL=muse-wonder-1.0
META_SPARK_MODEL=muse-spark-1.3
META_VOICE_MODEL=muse-voice-transcribe-1.0
META_SAM_MODEL=sam-3.1

# Demo mode (local only): set to 1 to allow unauthenticated access when
# NODE_ENV=production. Leave unset in real deployments.
# DEMO_MODE=

# Mobile (apps/mobile) — public values only
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_APP_URL=https://your-web-app.vercel.app
