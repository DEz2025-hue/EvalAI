{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/mobile/node_modules/expo/bin/cli", "start", "apps/mobile", "--web", "--port", "8082"],
      "port": 8082
    },
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/web/node_modules/next/dist/bin/next", "dev", "apps/web", "-p", "3000", "-H", "0.0.0.0"],
      "port": 3000,
      "autoPort": false
    }
  ]
}
